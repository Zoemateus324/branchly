PORT=3000
APP_URL=http://localhost:3000
DATABASE_PATH=./data/branchly.sqlite
NODE_ENV=development
# Production requires HTTPS, a verified Resend sender, and a 32-byte base64 encryption key.
# Generate the encryption key locally: node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
RESEND_API_KEY=
MAIL_FROM=
OPENAI_API_KEY=
OPENAI_MODEL=
AI_DAILY_LIMIT=20
# Never reuse credentials shared in chat. Supply new credentials through your host's secret settings.
EFI_ENV=sandbox
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_PLAN_ID=
EFI_PAYMENT_HOSTS=pagamento.gerencianet.com.br
META_GRAPH_VERSION=
META_APP_SECRET=
META_VERIFY_TOKEN=
# Optional platform webhook for n8n; fixed operator configuration, not visitor supplied.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
# Only behind a proxy which overwrites X-Real-IP; keep the app port private.
TRUST_PROXY=0
